# ── Base vectorielle PostgreSQL ─────────────────────────────
DATABASE_URL=postgresql://stevia:steviapassword@postgres:5432/stevia

# ── BookStack (documentation source) ────────────────────────
BOOKSTACK_URL=http://bookstack:80
BOOKSTACK_TOKEN_ID=your-token-id-here
BOOKSTACK_TOKEN_SECRET=your-token-secret-here

# ── Ollama (inférence LLM) ───────────────────────────────────
OLLAMA_HOST=ollama
OLLAMA_MODEL=gemma3:1b

# ── Répertoire temporaire ────────────────────────────────────
TMPDIR=/app/stevia_work/tmp

# ── Classifieur ML ───────────────────────────────────────────
ML_RELEVANCE_THRESHOLD=0.35
ML_RETRAIN_THRESHOLD=10
