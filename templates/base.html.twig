<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Accueil{% endblock %} — SUCRE · CPAM Hauts-de-Seine</title>

    {# Bootstrap 5 #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    {# SUCRE Theme #}
    <link rel="stylesheet" href="{{ asset('css/sucre.css') }}">
    {# Stevia Widget #}
    <link rel="stylesheet" href="{{ asset('css/stevia.css') }}">

    {% block stylesheets %}{% endblock %}
            {{ encore_entry_link_tags('app') }}
</head>
<body>

{# ============================================================
   TOP NAVBAR
   ============================================================ #}
<nav class="sucre-topnav" role="navigation" aria-label="Navigation principale">
    <div class="topnav-left">
        <button class="topnav-toggle" id="sidebarToggle" aria-label="Ouvrir/fermer le menu" aria-expanded="true" aria-controls="sucreSidebar">
            <i class="bi bi-list"></i>
        </button>
        <img src="{{ asset('images/logo-assurance-maladie.svg') }}" alt="Assurance Maladie" class="topnav-logo">
        <div class="topnav-brand">
            <span class="topnav-title">SUCRE</span>
            <span class="topnav-subtitle d-none d-lg-inline">Suivi des créances</span>
        </div>
    </div>
    <div class="topnav-right">
        <i class="bi bi-bell topnav-icon" title="Notifications"></i>
        <div class="topnav-user-info">
            <i class="bi bi-person-circle topnav-icon"></i>
            <div class="d-none d-md-block">
                <div class="topnav-username">Roni Cairo</div>
                <div class="topnav-role">Gestionnaire recouvrement</div>
            </div>
        </div>
    </div>
</nav>

{# ============================================================
   LAYOUT
   ============================================================ #}
<div class="sucre-layout" id="sucreLayout">

    {# SIDEBAR #}
    <aside class="sucre-sidebar" id="sucreSidebar" aria-label="Menu latéral">
        <nav>
            <ul class="sidebar-menu">

                <li class="sidebar-item {{ app.request.attributes.get('_route') == 'home' ? 'active' : '' }}">
                    <a href="{{ path('home') }}" class="sidebar-link">
                        <i class="bi bi-house-door"></i>
                        <span>Accueil</span>
                    </a>
                </li>

                <li class="sidebar-section-title">Recouvrement</li>

                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Créances amiable</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-briefcase"></i>
                        <span>Contentieux</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Suivi des dossiers</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Tableaux de bord</span>
                    </a>
                </li>

                <li class="sidebar-section-title">Tiers &amp; Débiteurs</li>

                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-people"></i>
                        <span>Débiteurs</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-building"></i>
                        <span>Employeurs</span>
                    </a>
                </li>

                <li class="sidebar-section-title">Stevia IA</li>

                <li class="sidebar-item {{ app.request.attributes.get('_route') == 'stevia_indexation' ? 'active' : '' }}">
                    <a href="{{ path('stevia_indexation') }}" class="sidebar-link">
                        <i class="bi bi-database-gear"></i>
                        <span>Indexation docs</span>
                    </a>
                </li>
            
                <li class="sidebar-item {{ app.request.attributes.get('_route') == 'stevia_ml' ? 'active' : '' }}">
                    <a href="{{ path('stevia_ml') }}" class="sidebar-link">
                        <i class="bi bi-cpu"></i>
                        <span>Entraînement ML</span>
                    </a>
                </li>

                <li class="sidebar-item {{ app.request.attributes.get('_route') == 'stevia_debug_classifieurs' ? 'active' : '' }}">
                    <a href="{{ path('stevia_debug_classifieurs') }}" class="sidebar-link">
                        <i class="bi bi-diagram-3"></i>
                        <span>Debug classifieurs</span>
                    </a>
                </li>

                <li class="sidebar-item {{ app.request.attributes.get('_route') == 'stevia_cache' ? 'active' : '' }}">
                    <a href="{{ path('stevia_cache') }}" class="sidebar-link">
                        <i class="bi bi-database-check"></i>
                        <span>Cache réponses</span>
                    </a>
                </li>

                <li class="sidebar-section-title">Administration</li>

                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-gear"></i>
                        <span>Paramètres</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class="bi bi-shield-check"></i>
                        <span>Droits &amp; Rôles</span>
                    </a>
                </li>

            </ul>
        </nav>

        {# Role switcher (démo locale) #}
        {% set currentRole = app.session.get('stevia_role', 'user') %}
        {% set roles = {
            'user':        {'label': 'Utilisateur',    'icon': 'bi-person'},
            'role_recouv': {'label': 'Recouvrement',   'icon': 'bi-briefcase'},
            'role_notif':  {'label': 'Notification',   'icon': 'bi-bell'},
            'role_mec':    {'label': 'MEC',             'icon': 'bi-building'},
            'role_admin':  {'label': 'Administrateur', 'icon': 'bi-shield-check'}
        } %}
        <div class="sidebar-role-switcher">
            <div class="role-switcher-label">
                <i class="bi bi-person-badge"></i> Rôle actif
            </div>
            <div class="role-switcher-current">
                <i class="bi {{ roles[currentRole].icon }}"></i>
                {{ roles[currentRole].label }}
                <i class="bi bi-chevron-up role-chevron"></i>
            </div>
            <div class="role-switcher-menu">
                {% for roleKey, roleData in roles %}
                    <form method="post" action="{{ path('switch_role', {role: roleKey}) }}">
                        <button type="submit" class="role-option {{ currentRole == roleKey ? 'active' : '' }}">
                            <i class="bi {{ roleData.icon }}"></i>
                            {{ roleData.label }}
                            {% if currentRole == roleKey %}<i class="bi bi-check2 ms-auto"></i>{% endif %}
                        </button>
                    </form>
                {% endfor %}
            </div>
        </div>

        <div class="sidebar-footer">
            <i class="bi bi-person-badge sidebar-footer-icon"></i>
            <div>
                <div class="sidebar-footer-name">Roni Cairo</div>
                <div class="sidebar-footer-role">v2.4.1</div>
            </div>
        </div>
    </aside>

    {# MAIN CONTENT #}
    <main class="sucre-main" id="sucreMain">

        {# Page header band #}
        <div class="page-entete">
            <div class="page-entete-left">
                <h1 class="page-entete-title">{% block page_title %}Tableau de bord{% endblock %}</h1>
                {% block breadcrumb %}{% endblock %}
            </div>
            <div class="page-entete-right">
                {% block page_actions %}{% endblock %}
            </div>
        </div>

        {# Flash messages #}
        <div class="px-4 pt-3">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'success' ? 'success' : (type == 'info' ? 'info' : 'warning')) }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# Page body #}
        <div class="page-body p-4">
            {% block content %}{% endblock %}
        </div>

    </main>
</div>

{# ============================================================
   STEVIA WIDGET (présent sur toutes les pages)
   ============================================================ #}
{% include 'stevia/_chatbot.html.twig' %}

{# Bootstrap JS #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{# Sidebar toggle #}
<script>
document.getElementById('sidebarToggle')?.addEventListener('click', () => {
    const layout = document.getElementById('sucreLayout');
    const btn    = document.getElementById('sidebarToggle');
    const isOpen = layout.classList.toggle('sidebar-collapsed');
    btn.setAttribute('aria-expanded', String(!isOpen));
});
</script>

{# Role switcher toggle #}
<script>
(function () {
    const switcher = document.querySelector('.sidebar-role-switcher');
    const current  = switcher?.querySelector('.role-switcher-current');
    if (!current) return;
    current.addEventListener('click', (e) => {
        e.stopPropagation();
        switcher.classList.toggle('open');
    });
    document.addEventListener('click', () => switcher.classList.remove('open'));
})();
</script>
{# Rôle courant exposé au chatbot #}
<script>window.STEVIA_ROLE = "{{ app.session.get('stevia_role', 'user') }}";</script>
<script>window.STEVIA_USER = "Roni Cairo";</script>
{# Stevia widget JS #}
<script src="{{ asset('js/chatbot.js') }}?v={{ 'now'|date('U') }}"></script>

{% block javascripts %}{% endblock %}
            {{ encore_entry_script_tags('app') }}
</body>
</html>
