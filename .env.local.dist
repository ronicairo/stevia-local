# Copier ce fichier en .env.local et adapter les valeurs
APP_ENV=dev
APP_SECRET=stevia-local-demo-cpam-2024-secret
STEVIA_API_URL=http://localhost:8001

# Tokens BookStack (récupérés depuis l'interface BookStack → Mon compte → Tokens API)
BOOKSTACK_TOKEN_ID=votre_token_id
BOOKSTACK_TOKEN_SECRET=votre_token_secret

# Modèle Ollama (doit être téléchargé : docker exec ollama ollama pull gemma3:1b)
OLLAMA_MODEL=gemma3:1b
